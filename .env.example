# Local development placeholders. Copy to .env if needed.
# .env is gitignored. Do not put a real password in git.

# Optional override. When this is unset, the installed app uses https://permit-control.local.
# Local API example:
# VITE_PERMIT_API_URL=http://127.0.0.1:5080

# ASP.NET Core reads these environment variables when present.
# Leave the password unset until a local PostgreSQL instance exists.
PERMIT_DB_HOST=localhost
PERMIT_DB_PORT=5432
PERMIT_DB_NAME=permit_control
PERMIT_DB_USER=permit_control_api
PERMIT_DB_PASSWORD=CHANGE_ME

# Future server filesystem root for attachment bytes.
# PostgreSQL stores metadata only.
PERMIT_FILE_ROOT=/srv/permit-control/files
